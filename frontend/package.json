{
  "name": "tracex-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:backdrops": "node scripts/prepare-backdrops.mjs",
    "predev": "npm run prepare:backdrops",
    "dev": "vite --port 5174",
    "prebuild": "npm run prepare:backdrops",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:banned": "node scripts/check-banned-patterns.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:backdrops": "node scripts/check-backdrops.mjs",
    "check:api-drift": "node scripts/check-api-drift.mjs",
    "gen:api": "node scripts/generate-openapi.mjs",
    "gen:permissions": "node scripts/generate-permissions.mjs",
    "check:permissions-drift": "node scripts/check-permissions-drift.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run src/components/ui/ui.test.tsx",
    "e2e": "playwright test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.0.1",
    "@tanstack/react-query": "5.74.4",
    "lucide-react": "0.503.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.56.1",
    "react-router-dom": "6.30.0",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.25.1",
    "@playwright/test": "1.52.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.14.1",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/coverage-v8": "3.1.2",
    "axe-core": "4.10.3",
    "eslint": "9.25.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.6.1",
    "sharp": "0.35.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.0",
    "vite": "6.3.3",
    "vitest": "3.1.2",
    "vitest-axe": "0.1.0"
  }
}
