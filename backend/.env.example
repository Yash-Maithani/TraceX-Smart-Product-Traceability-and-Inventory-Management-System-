# TraceX Backend Environment Configuration (Example)
# Copy to .env and provide real credentials for local development.

# ── Server & Runtime ─────────────────────────────────────────
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/tracex_fresh_dev

# ── Security & Authentication ────────────────────────────────
# Must be at least 32 characters in production
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_12345
TRACE_TOKEN_SECRET=your_trace_token_hmac_secret_here

# ── Origins & URLs ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
PUBLIC_TRACE_BASE_URL=http://localhost:5174

# ── Seed Runner ──────────────────────────────────────────────
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=your_seed_default_password_min_12_chars
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ── Documentation ────────────────────────────────────────────
SPRINGDOC_ENABLED=true

# ── Email (Spring Mail) ──────────────────────────────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ── AI Providers (Phase 11) ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_CACHE_TTL_HOURS=4
NVIDIA_API_KEY=your_nvidia_api_key_placeholder
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

BUSINESS_TIME_ZONE=Asia/Kolkata
